#!/usr/bin/env bash
# the judge's view of a review pair: the review under test (review.md), the
# file it reviewed (reviewed.yaml), the proposed spread test when the task
# brings its own (reviewed-test.yaml) and the task's key (key.yaml). the
# transcript goes, so the judge grades the answer, not the process.
set -eu

cp "$PATS_SCORED_TASK_DIR/key.yaml" "$PATS_WORKDIR/key.yaml"
for f in "$PATS_SCORED_TASK_DIR"/*.review.yaml; do
    cp "$f" "$PATS_WORKDIR/reviewed.yaml"
done
for f in "$PATS_SCORED_TASK_DIR"/*.review.test.yaml; do
    [ -e "$f" ] || continue
    cp "$f" "$PATS_WORKDIR/reviewed-test.yaml"
done
cd "$PATS_ROOT/scorers"
uv run --quiet --with pyyaml python -c 'from _lib import final_text; print(final_text())' >"$PATS_WORKDIR/review.md"
rm -f "$PATS_WORKDIR/stdout.log" "$PATS_WORKDIR/stderr.log"
