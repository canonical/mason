#!/usr/bin/env bash
# set up the workdir on the host:
#   stage [--branch <b>] [--source <b>] [--review <pkg>] [--knockout <slice>]... [--rock]
# --branch clones chisel-releases at <b>. --source adds another release branch
# as a local branch of the same name, for ports: egress keeps the agent off
# chisel-releases. --knockout takes that slice out as ground truth. each
# <target>.silver.yaml beside the task.yaml is ground truth for a target written
# from scratch. --review swaps <pkg>'s slice for the <pkg>.review.yaml beside
# the task.yaml, uncommitted, with upstream's spread test, or with a test of
# only the <pkg>.review.test.yaml beside it when there is one.
# --rock stages a rock task instead: the task's project/ (if any) becomes the
# workdir, one git commit, and its case.yaml, rockcraft.expected.yaml and tests
# are ground truth. installs the skills for the harness.
set -eu

REPO_ROOT="$(cd "$PATS_ROOT/../.." && pwd)"
OUT="$PATS_OUTPUT_DIR"
CASE="$PATS_TASK_NAME"

function _fail() {
    printf 'stage: %s\n' "$1" >&2
    exit 1
}

function _clone() {
    local branch="$1"
    git clone --quiet --depth 1 --branch "$branch" \
        https://github.com/canonical/chisel-releases.git "$PATS_WORKDIR"
    cd "$PATS_WORKDIR"
    printf '%s\n' "$branch" >"$OUT/$CASE.branch"
    # "v3" / "chisel-v1" / "1" -> 3 / 1 / 1
    local fmt
    fmt="$(grep -m1 '^format:' chisel.yaml | grep -oE '[0-9]+' | head -n1 || true)"
    printf '%s\n' "$fmt" >"$OUT/$CASE.format"
}

# _drop: a target's slice and spread test, for the agent to write.
function _drop() {
    rm -f "slices/$1.yaml"
    rm -rf "tests/spread/integration/$1"
}

# _reinit_git: one commit of the tree, so history holds no removed slice. no
# hooks: the host's would reject upstream's files.
function _reinit_git() {
    local branch="$1"
    local git=(git -c core.hooksPath=/dev/null -c commit.gpgsign=false -c user.name=pats -c user.email=pats@local)
    rm -rf .git
    git init --quiet -b "$branch"
    "${git[@]}" add -A
    "${git[@]}" commit --quiet -m "chisel-releases base (target slices removed)"
}

# _consumers: the <pkg>_<slice> names other slices files depend on, which a
# rewrite of <pkg> has to keep. scorers filter the loose grep.
function _consumers() {
    grep -rhoE "[a-z0-9.+-]*_[a-z0-9-]+" slices/ 2>/dev/null |
        grep -F "$1_" | sort -u >"$OUT/$1.consumers" || true
}

# _refs: package names a slices file mentions as <pkg>_<slice>, loosely.
function _refs() {
    grep -oE "[a-z0-9.+-]+_[a-z0-9-]+" "$1" | cut -d_ -f1 | sort -u
}

# _providers: the slices files ground truth's dependencies reach, transitively,
# so a scorer can tell another set of slices ships the same paths.
function _providers() {
    local t="$1" dir="$OUT/$1.providers" queue p seen
    mkdir -p "$dir"
    seen=" $t "
    queue="$(_refs "$OUT/$t.expected.yaml")"
    while [ -n "$queue" ]; do
        p="${queue%%$'\n'*}"
        if [ "$p" = "$queue" ]; then queue=""; else queue="${queue#*$'\n'}"; fi
        case "$seen" in (*" $p "*) continue ;; esac
        seen="$seen$p "
        [ -n "$p" ] && [ -f "slices/$p.yaml" ] || continue
        cp "slices/$p.yaml" "$dir/"
        queue="$queue"$'\n'"$(_refs "slices/$p.yaml")"
    done
}

# _add_source: upstream's <branch> as a local branch of the same name.
function _add_source() {
    local src="$1" tmp
    tmp="$(mktemp -d)"
    git clone --quiet --depth 1 --branch "$src" \
        https://github.com/canonical/chisel-releases.git "$tmp/src"
    git fetch --quiet --depth 1 "$tmp/src" "$src:$src"
    rm -rf "$tmp"
}

# _install: claude reads .claude/skills/, the other harnesses .agents/skills/.
function _install() {
    local dest=".agents/skills"
    case "$PATS_AGENT_HARNESS" in
        (claude-*) dest=".claude/skills" ;;
    esac
    mkdir -p "$PATS_WORKDIR/$dest"
    cp -R "$REPO_ROOT/skills/." "$PATS_WORKDIR/$dest/"
}

# _rock: a rock task's project in the workdir, as one git commit (rock-debugger
# commits its fixes, rockcraft init would make a repo anyway), and its ground
# truth in the output dir. spread tasks are kept as task.spread.yaml in this repo:
# a task.yaml under a pats task dir would be read as a nested pats task.
function _rock() {
    local git=(git -c core.hooksPath=/dev/null -c commit.gpgsign=false -c user.name=pats -c user.email=pats@local)
    cp "$PATS_TASK_DIR/case.yaml" "$OUT/$CASE.case.yaml"
    if [ -f "$PATS_TASK_DIR/rockcraft.expected.yaml" ]; then
        cp "$PATS_TASK_DIR/rockcraft.expected.yaml" "$OUT/rockcraft.expected.yaml"
    fi
    cd "$PATS_WORKDIR"
    if [ -d "$PATS_TASK_DIR/project" ]; then
        cp -R "$PATS_TASK_DIR/project/." .
        find . -name task.spread.yaml | while read -r t; do
            mv "$t" "${t%task.spread.yaml}task.yaml"
        done
        # the tests as given, in collect's tests.txt form: whether the agent
        # weakened them is scored against this.
        if [ -d spread ]; then
            find spread -name task.yaml | sort | while read -r t; do
                printf '# %s\n' "$t"
                cat "$t"
            done >"$OUT/tests.expected.txt"
        fi
        if [ -f rockcraft-test.yaml ]; then
            cp rockcraft-test.yaml "$OUT/rockcraft-test.expected.yaml"
        fi
    fi
    git init --quiet -b main
    printf '%s\n' .claude/ .agents/ >>.git/info/exclude
    "${git[@]}" add -A
    "${git[@]}" commit --quiet --allow-empty -m "rock project"
}

function main() {
    local branch="" source="" review="" knockout="" rock=0 silver t keep=""
    while [ $# -gt 0 ]; do
        case "$1" in
            (--branch) branch="$2"; shift 2 ;;
            (--source) source="$2"; shift 2 ;;
            (--review) review="$2"; shift 2 ;;
            (--knockout) knockout="$knockout $2"; shift 2 ;;
            (--rock) rock=1; shift ;;
            (*) _fail "unknown argument: $1" ;;
        esac
    done
    mkdir -p "$PATS_WORKDIR" "$OUT"
    if [ -n "$branch" ]; then
        _clone "$branch"
        # shellcheck disable=SC2086
        for t in $knockout; do
            [ -f "slices/$t.yaml" ] || _fail "no slices/$t.yaml on $branch to knock out"
            cp "slices/$t.yaml" "$OUT/$t.expected.yaml"
            _drop "$t"
            _consumers "$t"
            _providers "$t"
        done
        for silver in "$PATS_TASK_DIR"/*.silver.yaml; do
            [ -e "$silver" ] || continue
            t="$(basename "$silver" .silver.yaml)"
            cp "$silver" "$OUT/$t.expected.yaml"
            _drop "$t"
            _providers "$t"
        done
        if [ -n "$review" ]; then
            [ -f "$PATS_TASK_DIR/$review.review.yaml" ] || _fail "no $review.review.yaml beside the task"
            keep="$(mktemp -d)"
            mkdir "$keep/test"
            if [ -f "$PATS_TASK_DIR/$review.review.test.yaml" ]; then
                cp "$PATS_TASK_DIR/$review.review.test.yaml" "$keep/test/task.yaml"
            elif [ -d "tests/spread/integration/$review" ]; then
                cp -R "tests/spread/integration/$review/." "$keep/test"
            fi
            _drop "$review"
        fi
        rm -rf "tests/spread/integration/$CASE"
        _reinit_git "$branch"
        if [ -n "$source" ]; then
            _add_source "$source"
        fi
        # review: the proposed files land uncommitted on the clean base.
        if [ -n "$review" ]; then
            cp "$PATS_TASK_DIR/$review.review.yaml" "slices/$review.yaml"
            cp -R "$keep/test" "tests/spread/integration/$review"
            rm -rf "$keep"
        fi
    elif [ -n "$knockout" ] || [ -n "$source" ] || [ -n "$review" ]; then
        _fail "--knockout, --source and --review need --branch"
    fi
    _install
    if [ "$rock" = 1 ]; then
        _rock
    fi
}

main "$@"
