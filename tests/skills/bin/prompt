#!/usr/bin/env python3
"""prompt: print the task's prompt.md (run in the task's dir).

a -noskill baseline agent gets the same task without the skill: "Use the <x>
skill to <verb>" becomes "<Verb>", and the sentences pointing at the skill's
workflow and knowledge base go. a review is asked to end on one of the
verdict words the skill uses. any mention of a skill left after that is an
error, so a new prompt shape can't leak the skill into the baseline.
"""
import os
import re
import sys
from pathlib import Path

text = Path("prompt.md").read_text()
if os.environ.get("PATS_AGENT_NAME", "").endswith("-noskill"):
    text = re.sub(r"Use the [\w-]+ skill to (\w)", lambda m: m.group(1).upper(), text)
    text = text.replace(", following the skill's workflow and the conventions in its knowledge base.", ".")
    text = text.replace(
        " Follow the skill's workflow and the conventions in its knowledge base, including any inter-package dependencies between them.",
        " Account for any inter-package dependencies between them.",
    )
    text = text.replace(" Follow the skill's workflow and the conventions in its knowledge base.", "")
    text = text.replace("the spread test the workflow asks for", "a spread test")
    text = text.replace("the spread tests the workflow asks for", "a spread test for each")
    # the verdict scorer reads the skill's three words: name them, not what they mean.
    text = text.replace(
        "Your final message is the review.",
        "Your final message is the review. End it with a verdict: approve, request-changes or incomplete.",
    )
    if re.search(r"skill|mason", text, re.IGNORECASE):
        sys.exit("prompt: the baseline prompt still mentions a skill")
sys.stdout.write(text)
