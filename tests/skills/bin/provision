#!/bin/sh
# the pats sandbox plus what the skills run: dpkg-deb, pyyaml, uv, chisel.
# provision --rock: also rockcraft, whose builds and `rockcraft test` run lxd
# instances -- for the rock sandbox, an lxd container with snapd.
set -eu

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends dpkg-dev file python3-yaml
apt-get clean
rm -rf /var/lib/apt/lists/*

# v1 lets `git ls-remote` read refs from info/refs, which egress allows. v2 posts
# to git-upload-pack, which egress denies.
git config --system protocol.version 1

curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

arch="$(dpkg --print-architecture)"
# the tag the latest release redirects to. the api rate-limits unauthenticated
# callers by address, and ci runners share theirs.
ver="$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/canonical/chisel/releases/latest)"
ver="${ver##*/}"
curl -fsSL "https://github.com/canonical/chisel/releases/download/$ver/chisel_${ver}_linux_$arch.tar.gz" \
    -o /tmp/chisel.tgz
tar -xzf /tmp/chisel.tgz -C /usr/local/bin chisel
rm /tmp/chisel.tgz
chisel version

if [ "${1:-}" = --rock ]; then
    apt-get update
    apt-get install -y --no-install-recommends git openssh-server snapd sudo
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    snap wait system seed.loaded
    snap list lxd >/dev/null 2>&1 || snap install lxd
    lxd waitready --timeout=120
    lxd init --auto

    # the agent drives lxd through its group. pats makes that user after this
    # script, unless it is there.
    id -u pats >/dev/null 2>&1 || useradd -m -s /bin/bash pats
    usermod -aG lxd pats

    # two settings without which no rock packs here: rockcraft's build
    # instances are lxd containers inside this lxd container. each works around
    # something upstream (tests/skills/README.md has the references).
    #
    # a second-level container gets no apparmor namespace of its own, and snapd
    # dies loading a profile it may not load. with no apparmor in sight (both
    # paths: snap-confine asks the module) it runs without.
    lxc profile set default raw.lxc 'lxc.mount.entry = tmpfs sys/kernel/security tmpfs rw,nosuid,nodev,noexec 0 0
lxc.mount.entry = tmpfs sys/module/apparmor tmpfs ro,nosuid,nodev,noexec 0 0'
    # rockcraft maps the project's owner to the instance's root and copies
    # each build instance from a base one. nested, lxd shifts the copy's files
    # a second time. a privileged instance has no id map to shift, and is
    # still held by this container's own user namespace.
    lxc profile set default security.privileged true
    snap install rockcraft --classic

    # a snap here cannot write to a regular file it inherits as stdout or
    # stderr, which is what an agent's shell hands every command: the output is
    # lost and rockcraft exits 120. a wrapper ahead of /snap/bin on PATH puts
    # pipes in between.
    cat >/usr/local/bin/rockcraft <<'EOF'
#!/bin/bash
snap="/snap/bin/$(basename "$0")"
if [ ! -f /proc/self/fd/1 ] && [ ! -f /proc/self/fd/2 ]; then
    exec "$snap" "$@"
fi
set -o pipefail
{ "$snap" "$@" 2>&1 >&3 3>&- | cat >&2 3>&-; } 3>&1 | cat
EOF
    chmod +x /usr/local/bin/rockcraft
    cp /usr/local/bin/rockcraft /usr/local/bin/lxc
    hash -r
    rockcraft --version >/root/wrapped.out
    [ -s /root/wrapped.out ]
    lxc version >/root/wrapped.out
    [ -s /root/wrapped.out ]
    rm /root/wrapped.out

    # the sandbox sets CI, and `rockcraft test` then runs the tests on this
    # machine in place of a virtual machine: only those of a project that lists
    # this machine's system. `rockcraft init` has to write such a project.
    system="$(. /etc/os-release && echo "$ID-$VERSION_ID")"
    canary="$(mktemp -d)"
    (cd "$canary" && rockcraft init --profile=test --name canary >/dev/null)
    if ! grep -q "^ *- $system:" "$canary/spread.yaml"; then
        echo "provision: rockcraft init tests on another system than this sandbox's $system:" >&2
        grep -A2 'systems:' "$canary/spread.yaml" >&2
        echo "provision: set the base of rock-lxd in pats.yaml to that system" >&2
        exit 1
    fi
    rm -rf "$canary"
fi
